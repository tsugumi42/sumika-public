{
  "$description": "语义层：按用途起名，名字照设计语言（ADR-347）。组件只用这一层。",
  "color": {
    "$type": "color",
    "surface": {
      "$value": "{ramp.surface}"
    },
    "bg": {
      "$value": "{ramp.bg}"
    },
    "rail": {
      "$value": "{ramp.rail}"
    },
    "float": {
      "$value": "{ramp.float}"
    },
    "sunken": {
      "$value": "{ramp.sunken}"
    },
    "sunken-hover": {
      "$value": "{ramp.sunken-hover}"
    },
    "line": {
      "$value": "{ramp.line}"
    },
    "line-strong": {
      "$value": "{ramp.line-strong}"
    },
    "text": {
      "$value": "{ramp.text}"
    },
    "text-2": {
      "$value": "{ramp.text-2}"
    },
    "text-3": {
      "$value": "{ramp.text-3}"
    },
    "bubble": {
      "$value": "{ramp.bubble}"
    },
    "chat-bg": {
      "$value": "{ramp.chat-bg}"
    },
    "hover": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.1059, 0.1333, 0.1647],
        "alpha": 0.059,
        "hex": "#1b222a0f"
      },
      "$extensions": {
        "sumika": {
          "alpha": ["{ramp.text}", "{alpha.hover}"]
        }
      }
    },
    "press": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.1059, 0.1333, 0.1647],
        "alpha": 0.11,
        "hex": "#1b222a1c"
      },
      "$extensions": {
        "sumika": {
          "alpha": ["{ramp.text}", "{alpha.press}"]
        }
      }
    },
    "float-ring": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.1059, 0.1333, 0.1647],
        "alpha": 0.059,
        "hex": "#1b222a0f"
      },
      "$extensions": {
        "sumika": {
          "alpha": ["{ramp.float-ring-base}", "{alpha.float-ring}"]
        }
      }
    },
    "shadow-a": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.1059, 0.1333, 0.1647],
        "alpha": 0.102,
        "hex": "#1b222a1a"
      },
      "$extensions": {
        "sumika": {
          "alpha": ["{ramp.shadow-base}", "{alpha.shadow-a}"]
        }
      }
    },
    "shadow-b": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.1059, 0.1333, 0.1647],
        "alpha": 0.059,
        "hex": "#1b222a0f"
      },
      "$extensions": {
        "sumika": {
          "alpha": ["{ramp.shadow-base}", "{alpha.shadow-b}"]
        }
      }
    },
    "dot-ink": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.1059, 0.1333, 0.1647],
        "alpha": 0.09,
        "hex": "#1b222a17"
      },
      "$extensions": {
        "sumika": {
          "alpha": ["{ramp.text}", "{alpha.dot}"]
        }
      }
    },
    "scrollbar": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.1059, 0.1333, 0.1647],
        "alpha": 0.322,
        "hex": "#1b222a52"
      },
      "$extensions": {
        "sumika": {
          "alpha": ["{ramp.text}", "{alpha.scrollbar}"]
        }
      }
    },
    "on-danger": {
      "$value": "{ink.on-danger}"
    },
    "danger": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.7294, 0.2863, 0.2275],
        "hex": "#ba493a"
      },
      "$extensions": {
        "sumika": {
          "reach": {
            "base": "{hue.danger}",
            "min": "{contrast.text}",
            "away": "{contrast.away}",
            "against": ["{color.bg}", "{color.surface}"]
          }
        }
      }
    },
    "danger-hover": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.651, 0.2118, 0.1608],
        "hex": "#a63629"
      },
      "$extensions": {
        "sumika": {
          "shift": ["{color.danger}", "{contrast.danger-hover-shift}"]
        }
      }
    },
    "ok": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.1922, 0.5608, 0.3529],
        "hex": "#318f5a"
      },
      "$extensions": {
        "sumika": {
          "reach": {
            "base": "{hue.ok}",
            "min": "{contrast.icon}",
            "away": "{contrast.away}",
            "against": ["{color.bg}", "{color.surface}", "{color.sunken}"]
          }
        }
      }
    },
    "ok-text": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.0353, 0.3608, 0.2039],
        "hex": "#095c34"
      },
      "$extensions": {
        "sumika": {
          "reach": {
            "base": "{hue.ok-text}",
            "min": "{contrast.text}",
            "away": "{contrast.away}",
            "against": ["{color.surface}", "{color._mix.hover-surface}", "{color._mix.ok-surface}", "{color.sunken}", "{color._mix.hover-sunken}", "{color._mix.ok-sunken}", "{color.bg}"]
          }
        }
      }
    },
    "danger-text": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.6235, 0.1804, 0.1333],
        "hex": "#9f2e22"
      },
      "$extensions": {
        "sumika": {
          "reach": {
            "base": "{color.danger}",
            "min": "{contrast.text}",
            "away": "{contrast.away}",
            "against": ["{color.surface}", "{color._mix.hover-surface}", "{color._mix.danger-surface}", "{color.sunken}", "{color._mix.hover-sunken}", "{color._mix.danger-sunken}", "{color.bg}"]
          }
        }
      }
    },
    "_mix": {
      "$description": "只给对比度计算用：diff 的同色淡底（叠在卡片凹块上）",
      "hover-surface": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.9373, 0.9412, 0.949],
          "hex": "#eff0f2"
        },
        "$extensions": {
          "sumika": {
            "over": {
              "fg": "{color.hover}",
              "bg": "{color.surface}"
            }
          }
        }
      },
      "hover-sunken": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.8588, 0.8784, 0.8941],
          "hex": "#dbe0e4"
        },
        "$extensions": {
          "sumika": {
            "over": {
              "fg": "{color.hover}",
              "bg": "{color.sunken}"
            }
          }
        }
      },
      "ok-surface": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.8275, 0.8824, 0.8588],
          "hex": "#d3e1db"
        },
        "$extensions": {
          "sumika": {
            "over": {
              "fg": "{color.ok}",
              "bg": "{color._mix.hover-surface}",
              "k": "{contrast.diff-tint}"
            }
          }
        }
      },
      "ok-sunken": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.7608, 0.8314, 0.8118],
          "hex": "#c2d4cf"
        },
        "$extensions": {
          "sumika": {
            "over": {
              "fg": "{color.ok}",
              "bg": "{color._mix.hover-sunken}",
              "k": "{contrast.diff-tint}"
            }
          }
        }
      },
      "danger-surface": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.9059, 0.8431, 0.8392],
          "hex": "#e7d7d6"
        },
        "$extensions": {
          "sumika": {
            "over": {
              "fg": "{color.danger}",
              "bg": "{color._mix.hover-surface}",
              "k": "{contrast.diff-tint}"
            }
          }
        }
      },
      "danger-sunken": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.8392, 0.7882, 0.7922],
          "hex": "#d6c9ca"
        },
        "$extensions": {
          "sumika": {
            "over": {
              "fg": "{color.danger}",
              "bg": "{color._mix.hover-sunken}",
              "k": "{contrast.diff-tint}"
            }
          }
        }
      }
    }
  },
  "diff": {
