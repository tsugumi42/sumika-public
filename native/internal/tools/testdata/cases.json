  }
 },
 {
  "name": "ps-trash-not-empty",
  "about": "目录不是空的又没写 -Recurse：报错、不删。结果里有\"Line | 42\"（回收站前缀占了前面的行）。Bun 录的带 pwsh 的 ANSI 颜色码（设了 NO_COLOR 就没有），Go 输出纯文本，比的是 intended.json 里登记的那份（ADR-182）；改了 trash.ts、换了 pwsh 版本都会让它变，先重新生成 golden、改登记再看是不是 Go 的问题",
  "tool": "powershell",
  "args": {
   "purpose": "跑一下",
   "command": "Remove-Item sub"
  },
  "files": {
   "sub/x.txt": "x"
  }
 },
 {
  "name": "ps-timeout",
  "about": "超时：杀掉、已有的输出后面接\"Command timed out after 4 seconds\"",
  "tool": "powershell",
  "args": {
   "purpose": "跑一下",
   "command": "Write-Output 'start'; Start-Sleep 30",
   "timeout": 4
  }
 },
