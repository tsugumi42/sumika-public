 {
  "name": "ps-path-bin",
  "about": "PATH 里加了 pi 的 bin 目录（<HOME>/.pi/agent/bin；商店版 pwsh 自己又往最前面加了一段，所以不看第一个）",
  "tool": "powershell",
  "args": {
   "purpose": "跑一下",
   "command": "@($env:Path -split ';' | Where-Object { $_ -like '*\\.pi\\agent\\bin' }).Count"
  }
 },
 {
  "name": "ps-pi-env",
  "about": "pi 会话的变量（外面设了也）不传给命令",
  "tool": "powershell",
  "args": {
   "purpose": "跑一下",
   "command": "\"[$env:PI_SESSION_ID][$env:PI_MODEL]\""
  },
  "env": {
   "PI_SESSION_ID": "外面的会话",
   "PI_MODEL": "外面的模型"
  }
 },
 {
  "name": "ps-lines",
  "about": "超过 2000 行：留最后 2000 行、完整输出存文件",
  "tool": "powershell",
  "args": {
   "purpose": "跑一下",
   "command": "1..2500 | ForEach-Object { \"line $_\" }"
  }
 },
 {
  "name": "ps-bytes",
  "about": "超过 50KB：按字节留尾巴",
  "tool": "powershell",
  "args": {
   "purpose": "跑一下",
   "command": "1..1000 | ForEach-Object { 'x' * 100 }"
  }
 },
 {
  "name": "ps-long-line",
  "about": "一行就超过 50KB、没有换行：留这一行的最后 50KB",
  "tool": "powershell",
  "args": {
   "purpose": "跑一下",
   "command": "[Console]::Out.Write('y' * 60000)"
  }
 },
 {
  "name": "ps-long-line-nl",
  "about": "一行超过 50KB、末尾有换行：pi 写的\"这一行多大\"是 0B（换行后面那一行）",
  "tool": "powershell",
  "args": {
   "purpose": "跑一下",
   "command": "[Console]::Out.Write(('z' * 60000) + \"`n\")"
  }
 },
 {
  "name": "ps-bad-utf8",
  "about": "不是合法 UTF-8 的字节：按 WHATWG 的规则换成 U+FFFD",
  "tool": "powershell",
  "args": {
   "purpose": "跑一下",
   "command": "$o = [Console]::OpenStandardOutput(); $o.Write([byte[]](0xE4,0xB8,0x41,0xFF,0xF0,0x9F,0x98,0x0A), 0, 8); $o.Flush()"
  }
 },
 {
