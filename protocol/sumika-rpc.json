{
  "doc": "界面和后台之间的 JSON-RPC 2.0 协议（规格-Bun后台第1批 第四节）。这是唯一的定义：Go（native/internal/rpcwire/wire_gen.go）和 TS（server/src/protocol/gen.ts）都由 bun scripts/gen-rpc.ts 从这里生成，不手改生成文件。字段写法 \"名字?: 类型\"：带 ? 的结构体字段可以没有（Go 里是指针）；标量、数组、映射一律零值不发，收到缺省按零值。类型：string int int64 float bool bytes(base64) any T[] map<string,T> Result<T> List<T> 和下面定义的名字。",
  "protocol_version": 1,
  "limits": { "max_request_mib": 32, "max_response_mib": 64 },
  "errors": [
    { "code": -32700, "name": "parse" },
    { "code": -32600, "name": "invalid_request" },
    { "code": -32601, "name": "method_not_found" },
    { "code": -32602, "name": "invalid_params" },
    { "code": -32603, "name": "internal" },
    { "code": 1001, "name": "unsupported", "doc": "这个后台不支持这个能力（api.Unsupported）" },
    { "code": 1002, "name": "failed", "doc": "查了但失败；message 是给人看的原因" },
    { "code": 1003, "name": "not_initialized", "doc": "还没 initialize 就调别的方法" },
    { "code": 1004, "name": "bad_cursor", "doc": "预留" },
    { "code": 1010, "name": "local_chat_unsupported", "doc": "api.ErrLocalChatUnsupported" },
    { "code": 1011, "name": "local_chat_busy", "doc": "api.ErrLocalChatBusy" },
    { "code": 1012, "name": "approval_gone", "doc": "api.ErrApprovalGone" },
    { "code": 1013, "name": "question_gone", "doc": "api.ErrQuestionGone" },
    { "code": 1014, "name": "quote_target", "doc": "api.ErrQuoteTarget" },
    { "code": 1015, "name": "bad_part", "doc": "api.ErrPart" },
    { "code": 1016, "name": "read_mark_unsupported", "doc": "api.ErrReadMarkUnsupported" },
    { "code": 1017, "name": "no_avatar", "doc": "api.ErrNoAvatar" },
    { "code": 1018, "name": "not_found", "doc": "api.ErrNotFound" },
    { "code": 1019, "name": "input_conflict", "doc": "插话目标不对、客户端键冲突（Bun 用；Go 报 1002）" },
    { "code": 1020, "name": "input_not_pending", "doc": "撤回、放行一句已经开始处理的话（Bun 用；Go 报 1002）" },
    { "code": 1021, "name": "local_group_unsupported", "doc": "api.ErrLocalGroupUnsupported" },
    { "code": 1022, "name": "local_group_busy", "doc": "api.ErrLocalGroupBusy" },
    { "code": 1023, "name": "selftest_character", "doc": "自检（selftest.*）指定的角色不存在" },
    { "code": 1024, "name": "selftest_invalid", "doc": "自检（selftest.*）的命令不合格、批号没见过；message 是给人看的原因" }
  ],
  "types": [
    { "name": "ConversationKey", "doc": "会话身份，原样来自库，不从参与者反推", "fields": [
      "platform: string", "channel: string", "scene: string", "conversation: string" ] },
    { "name": "EventKey", "fields": [ "platform: string", "event_id: string" ] },
    { "name": "EventRef", "doc": "把事件限定在一个会话里；单凭 seq 不能认定事件", "fields": [
      "conversation: ConversationKey", "event: EventKey" ] },
    { "name": "RuntimeAlert", "fields": [ "key: string", "title: string", "body: string" ] },
    { "name": "RuntimeView", "fields": [
      "mode: string", "phase: string", "account: string // 打码后的显示身份", "connection: string",
      "reason_code: string", "reason: string", "alerts: List<RuntimeAlert>" ] },
    { "name": "CharacterView", "fields": [ "id: string", "name: string", "color: string", "model: string", "status: string" ] },
    { "name": "Capability", "fields": [ "name: string", "state: string", "reason: string" ] },
    { "name": "CardView", "fields": [ "title: string", "description: string", "source: string", "url: string" ] },
    { "name": "MediaRef", "doc": "媒体凭据：hash 是 64 位小写十六进制，不是路径", "fields": [
      "source: EventRef", "hash: string", "forward: string[]" ] },
    { "name": "VideoDownloadRef", "fields": [ "source: EventRef", "index: int", "forward: string[]", "node: int" ] },
    { "name": "ForwardBrief", "fields": [ "title: string", "lines: string[] // 最多 3 行", "count: int", "missing: int", "state: string" ] },
    { "name": "DisplaySegment", "doc": "后台整理好的展示段，界面不解析原始 JSON", "fields": [
      "kind: string", "text: string", "target: string", "ref: string",
      "media?: MediaRef", "cover?: MediaRef", "duration_ms: int64", "fetch_state: string", "file_kind: string",
      "download?: VideoDownloadRef", "width: int", "height: int", "animated: bool", "sticker: bool",
      "summary: string", "name: string", "size: int64", "card?: CardView", "links: string[]",
      "forward?: ForwardBrief", "media_state: string", "issue: string" ] },
    { "name": "QuoteView", "fields": [
      "ref: EventRef", "actor_kind: string", "display_name: string", "text: string", "recalled: bool",
      "segments: DisplaySegment[]", "snippet: string", "snippet_start: int", "snippet_end: int",
      "snippet_whole: bool", "snippet_fallback: bool", "snippet_truncated: bool" ] },
    { "name": "RecallPrior", "fields": [ "text: string", "created_at: int64" ] },
    { "name": "RecallItem", "fields": [
      "text: string", "kind: string", "source: string", "created_at: int64", "pinned: bool", "hearsay: bool",
      "score: float", "rerank: float", "sim: float", "lexical: int", "vector: int", "previous: RecallPrior[]" ] },
    { "name": "LocalProcessStep", "fields": [
      "id: string", "kind: string", "tool: string", "target: string", "thought: string", "output: string",
      "state: string", "rule: string", "step: int", "seconds: int", "started: int64", "recall: RecallItem[]" ] },
    { "name": "LocalAttachment", "fields": [
      "kind: string", "media?: MediaRef", "path: string", "name: string", "width: int", "height: int" ] },
    { "name": "MessagePart", "fields": [
      "has_quote: bool", "ref?: EventRef", "quote?: Result<QuoteView>", "text: string", "attachments: LocalAttachment[]" ] },
    { "name": "ReactionView", "fields": [
      "id: string", "ref: string", "actor_kind: string", "actor_id: string", "display_name: string", "at: int64" ] },
    { "name": "ProactiveMark", "fields": [ "thread: string", "reason: string" ] },
    { "name": "MessageView", "fields": [
      "ref: EventRef", "version: int64", "seq: int64 // 只用于排序和水位",
      "actor_kind: string", "actor_id: string", "actor_uid: string // 只用于头像，不是权限依据",
      "display_name: string // 只用于显示，不是权限依据",
      "kind: string", "process: LocalProcessStep[]", "service: string", "origin: string", "created_at: int64",
      "text: string", "segments: DisplaySegment[]", "unsent: bool", "partial: bool", "aborted: bool", "recalled: bool",
      "reply_to?: EventRef", "reply?: Result<QuoteView>", "reactions: ReactionView[]", "parts: MessagePart[]",
      "proactive?: ProactiveMark" ] },
    { "name": "ConversationView", "fields": [
      "key: ConversationKey", "title: string", "observers: string[]", "created_at: int64", "last?: MessageView",
      "unread: int", "has_unread: bool", "workspace_cwd: string", "workspace_root: string" ] },
    { "name": "OverviewRequest", "fields": [ "cursor: string", "limit: int", "character: string // 观察过滤，不是可见性开关" ] },
    { "name": "Overview", "fields": [
      "characters: List<Result<CharacterView>>", "conversations: List<ConversationView>",
      "capabilities: Capability[]", "runtime: RuntimeView" ] },
    { "name": "MessagePage", "fields": [
      "items: MessageView[]", "next_cursor: string", "has_more: bool", "high_water: int64", "before?: MessageView" ] },
    { "name": "ConversationRequest", "fields": [ "key: ConversationKey", "character: string", "limit: int // 1..1000" ] },
    { "name": "ConversationSnapshot", "fields": [
      "conversation: ConversationView", "page: MessagePage", "changed: MessageView[]" ] },
    { "name": "MediaView", "fields": [ "bytes: bytes", "mime: string", "size: int64" ] },
    { "name": "FaceView", "fields": [ "id: string", "name: string", "kind: string", "char: string" ] },
    { "name": "Setting", "doc": "只给明确允许展示的安全值", "fields": [
      "key: string", "value: any", "source: string", "configured: bool", "effective: bool", "effective_value: any",
      "supported: bool", "name: string", "help: string", "unit: string", "choices: map<string,string>" ] },
    { "name": "Settings", "fields": [ "items: List<Result<Setting>>" ] },

    { "name": "ForwardRequest", "fields": [ "source: EventRef", "id: string", "via: string[]" ] },
    { "name": "ForwardNode", "fields": [ "uid: string", "name: string", "at: int64", "segments: DisplaySegment[]" ] },
    { "name": "ForwardView", "fields": [
      "id: string", "group: bool", "nodes: ForwardNode[]", "missing: int", "fetched: int64", "state: string", "depth: int" ] },
    { "name": "LocalDraft", "fields": [ "turn_id: string", "step: int", "text: string", "character_id: string", "reset: bool" ] },
    { "name": "EgressTarget", "fields": [ "kind: string", "value: string", "reason: string", "danger: bool" ] },
    { "name": "ApprovalWhisper", "fields": [ "source: ConversationKey", "batch: string", "character: string" ] },
    { "name": "ApprovalEgress", "fields": [ "id: string", "targets: EgressTarget[]", "danger: int", "unchecked: bool" ] },
    { "name": "LocalApproval", "fields": [
      "id: string", "character_id: string", "key: ConversationKey", "title: string", "tool: string", "subject: string",
      "why: string", "purpose: string", "preview: string", "workdir: string", "notes: string[]",
      "options: string[] // once 以外还能选的档：conversation | always", "kind_label: string", "expires_at: int64",
      "whisper?: ApprovalWhisper", "egress?: ApprovalEgress" ] },
    { "name": "LocalQuote", "fields": [ "ref: EventRef", "text: string", "start: int", "end: int" ] },
    { "name": "LocalPart", "fields": [
      "quote?: LocalQuote", "text: string", "attachments: LocalAttachment[]", "mentions: string[]", "all: bool" ] },
    { "name": "LocalInputSubmission", "fields": [
      "text: string", "mode: string // start | steer | queue", "client_key: string", "expected_run_id: string", "parts: LocalPart[]" ] },
    { "name": "InputReceipt", "fields": [ "input_id: string", "run_id: string", "state: string", "sequence: int64", "revision: int64" ] },
    { "name": "StopReceipt", "fields": [ "run_id: string", "revision: int64", "drained: bool" ] },
    { "name": "LocalRequeued", "fields": [ "input_id: string", "run_id: string", "text: string", "seq: int64" ] },
    { "name": "LocalRunSnapshot", "fields": [
      "process: LocalProcessStep[]", "input_id: string", "root_id: string", "run_id: string", "state: string", "outcome: string",
      "text: string", "revision: int64", "step: int", "sealed_step: int", "drained: bool",
      "reason_class: string", "reason_detail: string", "reason_model: string", "requeued: LocalRequeued[]" ] },
    { "name": "HeldInput", "fields": [ "key: ConversationKey", "input_id: string", "text: string", "accepted_at: int64" ] },
    { "name": "LocalQuestionOption", "fields": [ "label: string", "detail: string" ] },
    { "name": "LocalQuestion", "fields": [
      "id: string", "character_id: string", "key: ConversationKey", "text: string", "options: LocalQuestionOption[]", "expires_at: int64" ] },
    { "name": "ApprovalRule", "fields": [
      "scope: string", "key: string", "label: string", "tool: string", "effect: string", "pattern: string",
      "project: string", "session: string", "conversation: string", "dirs: string[]", "at: int64", "last_used: int64" ] },
    { "name": "ConversationApprovalMode", "fields": [ "mode: string", "default: string", "override: bool" ] },
    { "name": "WorkspaceInfo", "fields": [ "cwd: string", "root: string", "name: string", "bound: bool", "problem: string" ] },
    { "name": "CheckpointSummary", "fields": [
      "id: string", "run_id: string", "tool_id: string", "tool: string", "state: string", "created_ms: int64",
      "files: int", "bytes: int64", "child: bool", "note: string" ] },
    { "name": "CheckpointFile", "fields": [
      "path: string", "target_exists: bool", "current_exists: bool", "target_hash: string", "current_hash: string",
      "target_bytes: int64", "current_bytes: int64" ] },
    { "name": "CheckpointPlan", "fields": [ "id: string", "mode: string", "version: string", "workspace: string", "files: CheckpointFile[]" ] },
    { "name": "CheckpointRestore", "fields": [
      "target_id: string", "inverse_id: string", "state: string", "completed: string[]", "remaining: string[]" ] },
    { "name": "CheckpointProgress", "fields": [
      "target_id: string", "inverse_id: string", "state: string", "done: int", "total: int",
      "completed: string[]", "remaining: string[]", "outcome_saved: bool", "error: string" ] },

    { "name": "AvatarReadParams", "fields": [ "key: string" ] },
    { "name": "ReadMarkParams", "fields": [ "conversation: ConversationKey", "up_to: int64" ] },
    { "name": "PathResult", "fields": [ "path: string" ] },
    { "name": "ConversationParams", "fields": [ "conversation: ConversationKey" ] },
    { "name": "LocalSendParams", "doc": "stream 非空时服务端在发送过程中推 local.draft", "fields": [
      "conversation: ConversationKey", "text: string", "stream: string" ] },
    { "name": "LocalSendImagesParams", "fields": [ "conversation: ConversationKey", "text: string", "images: bytes[]", "stream: string" ] },
    { "name": "LocalSendPartsParams", "fields": [ "conversation: ConversationKey", "parts: LocalPart[]", "stream: string" ] },
    { "name": "LocalGroupCreateParams", "fields": [ "name: string", "characters: string[]" ] },
    { "name": "LocalGroupSendParams", "doc": "mentions 是被点名的角色 ID，空时从正文解析独立的 @名字；stream 非空时服务端在发送过程中推 local.draft 和 local_group.process", "fields": [
      "conversation: ConversationKey", "text: string", "mentions: string[]", "stream: string" ] },
    { "name": "LocalGroupProcessNotice", "doc": "turn 是这位成员在这一轮里的第几位发言（和 local.draft 的 turn_id 同一个号）", "fields": [
      "stream: string", "turn: string", "steps: LocalProcessStep[]" ] },
    { "name": "WhisperReceipt", "doc": "发出的悄悄话：批号和被唤起的角色（按第一次出现排序）", "fields": [ "batch: string", "characters: string[]" ] },
    { "name": "WhisperSendParams", "doc": "conversation 是引用所在的来源会话（本地群聊、QQ 私聊、QQ 群）；每块都要引用一句话、不带附件", "fields": [
      "conversation: ConversationKey", "parts: LocalPart[]" ] },
    { "name": "LogQuote", "fields": [ "name: string", "at: int64", "text: string" ] },
    { "name": "LogEntry", "doc": "对话日志里的一行，只带摘要；全文用 whisper_log.entry", "fields": [
      "id: string", "batch: string", "kind: string", "character: string", "parent: string", "at: int64", "state: string", "position: int",
      "summary: string", "runes: int", "targets: string[]", "quotes: LogQuote[]", "turn: string", "err: bool", "waiting: bool", "busy: bool",
      "egress: string", "egress_n: int", "egress_danger: int" ] },
    { "name": "LogPage", "fields": [ "entries: LogEntry[]", "next: string", "running: bool" ] },
    { "name": "LogDetail", "fields": [ "id: string", "kind: string", "title: string", "text: string", "args: string", "hidden: bool" ] },
    { "name": "WhisperLogReadParams", "fields": [ "conversation: ConversationKey", "cursor: string", "limit: int" ] },
    { "name": "WhisperLogEntryParams", "fields": [ "conversation: ConversationKey", "id: string", "with_thinking: bool" ] },
    { "name": "WhisperCancelParams", "fields": [ "conversation: ConversationKey", "batch: string", "character: string" ] },
    { "name": "WhisperCancelResult", "fields": [ "cancelled: int" ] },
    { "name": "WhisperLogSnapshot", "fields": [ "subscription: string", "version: int64", "result: Result<LogPage>" ] },
    { "name": "SelftestChatParams", "doc": "自检对话（只给 sumika-ctl 用）：没有会话 id，会话由后台按角色拼成自检话题；character 不能空；timeout_ms 在 (0, 300000]", "fields": [
      "character: string", "new: bool", "text: string", "timeout_ms: int64" ] },
    { "name": "SelftestTool", "fields": [ "name: string", "args: string", "result: string", "status: string", "error: bool" ] },
    { "name": "SelftestApproval", "fields": [
      "id: string", "title: string", "tool: string", "subject: string", "why: string", "purpose: string", "preview: string", "notes: string[]" ] },
    { "name": "SelftestChatResult", "doc": "status：done | waiting_approval | timeout | stopped | error | busy", "fields": [
      "status: string", "character: string", "topic: string", "conversation: string", "turn_id: string", "reply: string", "draft: string",
      "tools: SelftestTool[]", "model: string", "route: string", "elapsed_ms: int64", "approval?: SelftestApproval", "error: string" ] },
    { "name": "SelftestLoopPatch", "doc": "loop add|edit 带的日程和选项；kind 空表示日程不改；days 周日是 0", "fields": [
      "kind: string", "interval_sec: int64", "at: string", "days: int[]", "new_chat: string // 空：add 用默认、edit 不改；new：每次新聊天；same：同一个聊天", "notify: string" ] },
    { "name": "SelftestSlashParams", "doc": "自检会话里的 /goal、/loop、/trust（只给 sumika-ctl 用）：text 是拼好的斜杠命令全文；loop 非空时 text 只是任务文字", "fields": [
      "command: string // goal | loop | trust", "sub: string", "character: string", "text: string", "id: int", "loop?: SelftestLoopPatch" ] },
    { "name": "SelftestGoal", "fields": [
      "text: string", "status: string", "rounds: int", "max_rounds: int", "tokens_used: int64", "pause_reason: string", "last_judge: string", "line: string" ] },
    { "name": "SelftestLoop", "fields": [
      "id: int", "status: string", "prompt: string", "interval_sec: int64", "runs: int", "next_run: string", "line: string", "kind: string",
      "at: string", "days: int[]", "notify: string", "new_chat: bool" ] },
    { "name": "SelftestSlashResult", "fields": [
      "character: string", "topic: string", "conversation: string", "reply: string", "started: bool", "goal?: SelftestGoal", "loops: SelftestLoop[]" ] },
    { "name": "SelftestWhisperParams", "doc": "自检悄悄话（只给 sumika-ctl 用）：来源是第一个角色的自检话题，引用的文字来自命令行", "fields": [
      "characters: string[]", "source_text: string", "quote_name: string", "say: string", "timeout_ms: int64" ] },
    { "name": "SelftestWhisperBatchParams", "fields": [ "batch: string" ] },
    { "name": "SelftestWhisperEntry", "fields": [
      "character: string", "state: string", "position: int", "source_turn_running: bool", "detail: string", "note: string" ] },
    { "name": "SelftestWhisperResult", "doc": "pending：到时限还有没落定的", "fields": [
      "batch: string", "entries: SelftestWhisperEntry[]", "pending: bool", "elapsed_ms: int64" ] },
    { "name": "GoalInfo", "doc": "一个目标的详情；预算 0 表示不限；last_* 是裁判最近一次的判断（没判过 last_at 是 0）", "fields": [
      "text: string", "state: string // active | paused", "pause_reason: string", "rounds: int", "max_rounds: int", "tokens_used: int64", "max_tokens: int64",
      "started_at: int64", "last_reason: string", "last_achieved: bool", "last_failed: bool", "last_at: int64" ] },
    { "name": "LoopRun", "doc": "定期任务的一次运行记录", "fields": [ "at: int64", "result: string // content | quiet | error", "note: string", "missed: int" ] },
    { "name": "LoopInfo", "doc": "一个定期任务（时间都是 Unix 毫秒，0 = 没有）；interval_sec 为 0 表示由她自己定节奏；status 只有 running | paused（停了的不在这里）", "fields": [
      "id: int", "prompt: string", "status: string", "interval_sec: int64", "next_run: int64", "next_reason: string", "runs: int", "last_run: int64",
      "last_result: string // content | quiet | error，空 = 还没跑过", "last_note: string", "expires: int64",
      "kind: string // interval | daily | weekly | self", "at: string // 15:04，只有 daily、weekly", "days: int[] // 0 是周日，只有 weekly",
      "notify: string // content | errors | none", "new_chat: bool", "history: LoopRun[]" ] },
    { "name": "LoopSpec", "doc": "定期任务页表单填出来的一个任务（新建和修改共用）；kind 为 interval 看 interval_sec，daily 看 at，weekly 看 at 和 days，self 让她自己定", "fields": [
      "prompt: string", "kind: string", "interval_sec: int64", "at: string", "days: int[]", "notify: string", "new_chat: bool" ] },
    { "name": "ReminderRepeat", "doc": "周期；unit 空 = 一次性，minute | hour | day | week | month；weekdays 只给 week（1 周一 … 7 周日）", "fields": [
      "unit: string", "every: int", "weekdays: int[]" ] },
    { "name": "ReminderEvent", "doc": "提醒记录里的一笔；kind: create | edit | pause | resume | ring | done | cancel | defer", "fields": [
      "at: int64", "kind: string", "by: string", "note: string" ] },
    { "name": "ReminderInfo", "doc": "一条提醒（时间都是 Unix 毫秒，0 = 没有）；status: active | paused | done | cancelled；source: owner | chat | thread", "fields": [
      "id: int", "character: string", "text: string", "at: int64", "next_at: int64", "status: string", "source: string", "repeat: ReminderRepeat", "repeat_text: string",
      "targets: string[] // 自己写的目标，空 = 跟配置", "effective_targets: string[] // 实际发到哪：local | qq",
      "rings: int", "last_ring: int64", "last_note: string", "end_note: string", "ended_at: int64", "created: int64", "history: ReminderEvent[]" ] },
    { "name": "ReminderDraft", "doc": "界面上新建提醒的内容；at 写成 2026-11-10 09:00（本机时区）", "fields": [
      "text: string", "at: string", "repeat: ReminderRepeat", "targets: string[]" ] },
    { "name": "ReminderPatch", "doc": "界面上的修改。线上标量和数组零值不发，所以「改不改这一项」单独用 set 列出来：set 里没有的项不改（targets 写进 set 又是空 = 改成跟配置，paused 写进 set 又是 false = 恢复）", "fields": [
      "set: string[] // text | at | repeat | targets | paused", "text: string", "at: string", "repeat: ReminderRepeat", "targets: string[]", "paused: bool" ] },
