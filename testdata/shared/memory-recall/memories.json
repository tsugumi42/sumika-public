{
  "memories": [
    { "id": "m01", "character": "wudao", "type": "fact", "kind": "fact", "text": "主人在汐澜能源做结构工程师，主要画防波堤的受力图。", "subject": "owner", "scope": "public", "status": "active", "confirmed": "owner", "temporal": "stable", "source": { "speaker": "owner", "place": "qq_group", "conversation": "qq:group:g-lantern", "said_ago_days": 38 } },
    { "id": "m02", "character": "wudao", "type": "fact", "kind": "preference", "text": "主人喝咖啡只喝不加糖的冷萃，嫌拿铁太甜。", "subject": "owner", "scope": "public", "status": "active", "confirmed": "owner_said", "temporal": "stable", "source": { "speaker": "owner", "place": "qq_group", "conversation": "qq:group:g-lantern", "said_ago_days": 31 } },
    { "id": "m03", "character": "wudao", "type": "fact", "kind": "preference", "text": "主人睡前一定要听十分钟雨声白噪音，不然睡不着。", "subject": "owner", "scope": "owner", "status": "active", "confirmed": "owner_said", "temporal": "stable", "source": { "speaker": "owner", "place": "local_private", "conversation": "console:wudao:topic:t1", "session": "t1", "said_ago_days": 22 } },
    { "id": "m04", "character": "wudao", "type": "fact", "kind": "fact", "text": "主人的妹妹叫编造甲，在外地读编造专业，下个月放暑假回家。", "subject": "owner", "scope": "owner", "status": "active", "confirmed": "owner_said", "temporal": "stable", "source": { "speaker": "owner", "place": "qq_private", "conversation": "qq:private:u-bai", "said_ago_days": 17 } },
    { "id": "m05", "character": "wudao", "type": "fact", "kind": "fact", "text": "主人对花生过敏，吃到会起疹子，出去吃饭要提醒他看配料。", "subject": "owner", "scope": "owner", "status": "active", "confirmed": "owner_said", "temporal": "stable", "source": { "speaker": "owner", "place": "qq_private", "conversation": "qq:private:u-bai", "said_ago_days": 45 } },
    { "id": "m06", "character": "wudao", "type": "fact", "kind": "promise", "text": "约好每周日晚上九点，主人陪她一起看一集《海鸥旅馆》，不能剧透。", "subject": "owner", "scope": "owner", "status": "active", "confirmed": "owner", "temporal": "stable", "source": { "speaker": "owner", "place": "local_private", "conversation": "console:wudao:topic:t1", "session": "t1", "said_ago_days": 40 } },
    { "id": "m07", "character": "wudao", "type": "fact", "kind": "fact", "text": "主人下周五（5月16日）下午三点要去临澜造船厂面试，面试官是总工程师。", "subject": "owner", "scope": "owner", "status": "active", "confirmed": "owner_said", "temporal": "temporary", "valid_until_days": 2.5, "source": { "speaker": "owner", "place": "qq_private", "conversation": "qq:private:u-bai", "said_ago_days": 6 } },
    { "id": "m08", "character": "wudao", "type": "fact", "kind": "fact", "text": "主人住在柳桥路的合租房里。", "subject": "owner", "scope": "owner", "status": "superseded", "superseded_by": "m09", "confirmed": "owner_said", "temporal": "stable", "source": { "speaker": "owner", "place": "local_private", "conversation": "console:wudao:topic:t1", "session": "t1", "said_ago_days": 70 } },
    { "id": "m09", "character": "wudao", "type": "fact", "kind": "fact", "text": "主人上个月底搬到了河湾公寓，一个人住。", "subject": "owner", "scope": "owner", "status": "active", "confirmed": "owner_said", "temporal": "stable", "source": { "speaker": "owner", "place": "local_private", "conversation": "console:wudao:topic:t2", "session": "t2", "said_ago_days": 12 } },
    { "id": "m10", "character": "wudao", "type": "fact", "kind": "preference", "text": "主人最喜欢的颜色是靛蓝。", "subject": "owner", "scope": "public", "status": "superseded", "superseded_by": "m11", "confirmed": "owner_said", "temporal": "stable", "source": { "speaker": "owner", "place": "qq_group", "conversation": "qq:group:g-lantern", "said_ago_days": 60 } },
    { "id": "m11", "character": "wudao", "type": "fact", "kind": "preference", "text": "主人现在最喜欢的颜色改成了松绿，说靛蓝看腻了。", "subject": "owner", "scope": "public", "status": "active", "confirmed": "owner_said", "temporal": "stable", "source": { "speaker": "owner", "place": "qq_group", "conversation": "qq:group:g-lantern", "said_ago_days": 9 } },
    { "id": "m12", "character": "wudao", "type": "fact", "kind": "fact", "text": "主人说每周三晚上去游泳。", "subject": "owner", "scope": "public", "status": "superseded", "superseded_by": "m13", "confirmed": "owner_said", "temporal": "stable", "source": { "speaker": "owner", "place": "qq_group", "conversation": "qq:group:g-lantern", "said_ago_days": 55 } },
    { "id": "m13", "character": "wudao", "type": "fact", "kind": "fact", "text": "主人游泳改到每周二和周六早上，周三晚上要加班。", "subject": "owner", "scope": "public", "status": "active", "confirmed": "owner_said", "temporal": "stable", "source": { "speaker": "owner", "place": "qq_group", "conversation": "qq:group:g-lantern", "said_ago_days": 8 } },
    { "id": "m14", "character": "wudao", "type": "fact", "kind": "fact", "text": "主人5月7日（周三）要去牙科拔智齿，请假半天。", "subject": "owner", "scope": "owner", "status": "active", "confirmed": "owner_said", "temporal": "temporary", "valid_until_days": -6.5, "source": { "speaker": "owner", "place": "qq_private", "conversation": "qq:private:u-bai", "said_ago_days": 14 } },
    { "id": "m15", "character": "wudao", "type": "fact", "kind": "fact", "text": "主人这个周末在灯笼小队的线下聚会负责带茶具。", "subject": "owner", "scope": "conv:qq:group:g-lantern", "status": "active", "confirmed": "owner_said", "temporal": "temporary", "valid_until_days": -17, "source": { "speaker": "owner", "place": "qq_group", "conversation": "qq:group:g-lantern", "said_ago_days": 25 } },
    { "id": "m16", "character": "wudao", "type": "fact", "kind": "fact", "text": "主人这几天感冒了，在吃退烧药，嗓子哑。", "subject": "owner", "scope": "public", "status": "active", "confirmed": "owner_said", "temporal": "temporary", "source": { "speaker": "owner", "place": "qq_group", "conversation": "qq:group:g-lantern", "said_ago_days": 15 } },
    { "id": "m17", "character": "wudao", "type": "fact", "kind": "fact", "text": "青禾是灯笼小队的队长，负责排每月的活动日程。", "subject": "qq:u-qinghe", "scope": "conv:qq:group:g-lantern", "status": "active", "confirmed": "owner", "temporal": "stable", "source": { "speaker": "qq:u-qinghe", "place": "qq_group", "conversation": "qq:group:g-lantern", "said_ago_days": 80 } },
    { "id": "m18", "character": "wudao", "type": "fact", "kind": "preference", "text": "青禾不吃香菜，聚餐点菜要记得说免香菜。", "subject": "qq:u-qinghe", "scope": "conv:qq:group:g-lantern", "status": "active", "confirmed": "none", "temporal": "stable", "source": { "speaker": "qq:u-qinghe", "place": "qq_group", "conversation": "qq:group:g-lantern", "said_ago_days": 33 } },
    { "id": "m19", "character": "wudao", "type": "fact", "kind": "fact", "text": "阿渡养了一只叫年糕的橘猫，已经三岁了。", "subject": "qq:u-adu", "scope": "conv:qq:group:g-lantern", "status": "active", "confirmed": "none", "temporal": "stable", "source": { "speaker": "qq:u-adu", "place": "qq_group", "conversation": "qq:group:g-lantern", "said_ago_days": 50 } },
    { "id": "m20", "character": "wudao", "type": "fact", "kind": "fact", "text": "听阿渡说，千穗打算年底辞职去开一家独立书店。", "subject": "qq:u-chiho", "scope": "conv:qq:group:g-lantern", "status": "candidate", "confirmed": "none", "temporal": "stable", "source": { "speaker": "qq:u-adu", "place": "qq_group", "conversation": "qq:group:g-lantern", "said_ago_days": 5 } },
    { "id": "m21", "character": "wudao", "type": "fact", "kind": "fact", "text": "栗子说听说主人快要跳槽去船厂了，不确定是真是假。", "subject": "owner", "scope": "conv:qq:group:g-kite", "status": "candidate", "confirmed": "none", "temporal": "stable", "source": { "speaker": "qq:u-lizi", "place": "qq_group", "conversation": "qq:group:g-kite", "said_ago_days": 3 } },
    { "id": "m22", "character": "wudao", "type": "fact", "kind": "fact", "text": "青禾说灯笼小队下个月可能要换活动室，场地还没谈好。", "subject": "qq:u-qinghe", "scope": "conv:qq:group:g-lantern", "status": "candidate", "confirmed": "none", "temporal": "stable", "source": { "speaker": "qq:u-qinghe", "place": "qq_group", "conversation": "qq:group:g-lantern", "said_ago_days": 4 } },
    { "id": "m23", "character": "wudao", "type": "fact", "kind": "fact", "text": "千穗在学大提琴，周四晚上有课。", "subject": "qq:u-chiho", "scope": "conv:qq:group:g-lantern", "status": "active", "confirmed": "none", "temporal": "stable", "source": { "speaker": "qq:u-chiho", "place": "qq_group", "conversation": "qq:group:g-lantern", "said_ago_days": 28 } },
    { "id": "m24", "character": "wudao", "type": "fact", "kind": "fact", "text": "栗子私下告诉雾岛，她在准备给阿渡办一场生日惊喜，让雾岛别说出去。", "subject": "qq:u-lizi", "scope": "person:qq:u-lizi", "status": "active", "confirmed": "none", "temporal": "stable", "source": { "speaker": "qq:u-lizi", "place": "qq_private", "conversation": "qq:private:u-lizi", "said_ago_days": 10 } },
    { "id": "m25", "character": "wudao", "type": "fact", "kind": "fact", "text": "青禾私下说她最近压力很大，在考虑退出队长这个位置。", "subject": "qq:u-qinghe", "scope": "person:qq:u-qinghe", "status": "active", "confirmed": "none", "temporal": "stable", "source": { "speaker": "qq:u-qinghe", "place": "qq_private", "conversation": "qq:private:u-qinghe", "said_ago_days": 7 } },
    { "id": "m26", "character": "wudao", "type": "fact", "kind": "promise", "text": "灯笼小队约定每月第一个周六晚上八点语音聚会，缺席要提前说。", "subject": "", "scope": "conv:qq:group:g-lantern", "status": "active", "confirmed": "owner", "temporal": "stable", "source": { "speaker": "qq:u-qinghe", "place": "qq_group", "conversation": "qq:group:g-lantern", "said_ago_days": 90 } },
    { "id": "m27", "character": "wudao", "type": "fact", "kind": "boundary", "text": "主人说过，不要在群里提他的体重和减肥计划。", "subject": "owner", "scope": "owner", "status": "active", "confirmed": "owner", "temporal": "stable", "source": { "speaker": "owner", "place": "local_private", "conversation": "console:wudao:topic:t1", "session": "t1", "said_ago_days": 100 } },
    { "id": "m28", "character": "wudao", "type": "episode", "kind": "episode", "text": "上个月主人给她讲了去海边灯塔拍日落的经过，那天风很大，他拍了很多照片。", "scope": "owner", "status": "active", "source": { "speaker": "owner", "place": "local_private", "conversation": "console:wudao:topic:t1", "session": "t1", "said_ago_days": 35 } },
    { "id": "m29", "character": "wudao", "type": "episode", "kind": "episode", "text": "灯笼小队春季线上聚会，大家玩了一晚上你画我猜，阿渡全程抢答第一。", "scope": "conv:qq:group:g-lantern", "status": "active", "source": { "speaker": "owner", "place": "qq_group", "conversation": "qq:group:g-lantern", "said_ago_days": 45 } },
    { "id": "m30", "character": "wudao", "type": "fact", "kind": "preference", "text": "主人在玩一款叫《星轨列车》的节奏游戏，目标是通关困难模式。", "subject": "owner", "scope": "public", "status": "active", "confirmed": "owner_said", "temporal": "stable", "source": { "speaker": "owner", "place": "local_group", "conversation": "console:group:lg-teahouse", "said_ago_days": 20 } },
    { "id": "m31", "character": "wudao", "type": "fact", "kind": "fact", "text": "主人的生日是十月九日，不喜欢大张旗鼓，只想吃一碗长寿面。", "subject": "owner", "scope": "owner", "status": "active", "confirmed": "owner_said", "temporal": "stable", "source": { "speaker": "owner", "place": "qq_private", "conversation": "qq:private:u-bai", "said_ago_days": 60 } },
    { "id": "m32", "character": "wudao", "type": "fact", "kind": "fact", "text": "主人下周三出发去北港出差，要待一周。", "subject": "owner", "scope": "public", "status": "active", "confirmed": "owner_said", "temporal": "temporary", "valid_until_days": 12, "source": { "speaker": "owner", "place": "qq_group", "conversation": "qq:group:g-lantern", "said_ago_days": 2 } },
    { "id": "m33", "character": "wudao", "type": "fact", "kind": "promise", "text": "主人答应了青禾，这周六下午帮忙搬灯笼小队的道具箱。", "subject": "owner", "scope": "conv:qq:group:g-lantern", "status": "active", "confirmed": "owner_said", "temporal": "temporary", "valid_until_days": 3.5, "source": { "speaker": "owner", "place": "qq_group", "conversation": "qq:group:g-lantern", "said_ago_days": 4 } },
    { "id": "m34", "character": "wudao", "type": "fact", "kind": "fact", "text": "阿渡在一家动画外包公司做上色。", "subject": "qq:u-adu", "scope": "conv:qq:group:g-lantern", "status": "superseded", "superseded_by": "m35", "confirmed": "none", "temporal": "stable", "source": { "speaker": "qq:u-adu", "place": "qq_group", "conversation": "qq:group:g-lantern", "said_ago_days": 90 } },
    { "id": "m35", "character": "wudao", "type": "fact", "kind": "fact", "text": "阿渡上周离职了，现在在家接自由职业的上色单。", "subject": "qq:u-adu", "scope": "conv:qq:group:g-lantern", "status": "active", "confirmed": "none", "temporal": "stable", "source": { "speaker": "qq:u-adu", "place": "qq_group", "conversation": "qq:group:g-lantern", "said_ago_days": 6 } },
    { "id": "m36", "character": "wudao", "type": "fact", "kind": "fact", "text": "主人小时候养过一只乌龟，叫团团，养了九年。", "subject": "owner", "scope": "owner", "status": "active", "confirmed": "owner_said", "temporal": "stable", "source": { "speaker": "owner", "place": "local_private", "conversation": "console:wudao:topic:t2", "session": "t2", "said_ago_days": 52 } },
    { "id": "m37", "character": "wudao", "type": "fact", "kind": "fact", "text": "雾岛的名字是主人起的，来自他老家的一座海岛。", "subject": "owner", "scope": "owner", "status": "active", "confirmed": "owner", "temporal": "stable", "source": { "speaker": "owner", "place": "local_private", "conversation": "console:wudao:topic:t1", "session": "t1", "said_ago_days": 120 } },
    { "id": "m38", "character": "wudao", "type": "fact", "kind": "preference", "text": "主人喜欢周末早上去河边公园慢跑，大概五公里。", "subject": "owner", "scope": "public", "status": "active", "confirmed": "owner_said", "temporal": "stable", "source": { "speaker": "owner", "place": "qq_group", "conversation": "qq:group:g-lantern", "said_ago_days": 26 } },
    { "id": "m39", "character": "wudao", "type": "fact", "kind": "fact", "text": "主人说今晚要去取新买的显示器，会晚点回家。", "subject": "owner", "scope": "owner", "status": "active", "confirmed": "owner_said", "temporal": "temporary", "valid_until_days": -1.5, "source": { "speaker": "owner", "place": "local_private", "conversation": "console:wudao:topic:t1", "session": "t1", "said_ago_days": 2 } },
    { "id": "m40", "character": "wudao", "type": "fact", "kind": "fact", "text": "主人好像说过想学潜水，但没说什么时候。", "subject": "owner", "scope": "owner", "status": "candidate", "confirmed": "none", "temporal": "stable", "source": { "speaker": "owner", "place": "local_private", "conversation": "console:wudao:topic:t2", "session": "t2", "said_ago_days": 11 } },
    { "id": "m41", "character": "wudao", "type": "fact", "kind": "fact", "text": "千穗在市图书馆做编目员。", "subject": "qq:u-chiho", "scope": "public", "status": "active", "confirmed": "none", "temporal": "stable", "source": { "speaker": "qq:u-chiho", "place": "qq_group", "conversation": "qq:group:g-lantern", "said_ago_days": 70 } },
    { "id": "m42", "character": "wudao", "type": "fact", "kind": "fact", "text": "风筝社每周四晚上固定在线上剪辑放风筝的视频，作品周日发布。", "subject": "qq:u-lizi", "scope": "conv:qq:group:g-kite", "status": "active", "confirmed": "none", "temporal": "stable", "source": { "speaker": "qq:u-lizi", "place": "qq_group", "conversation": "qq:group:g-kite", "said_ago_days": 40 } },
    { "id": "m43", "character": "wudao", "type": "fact", "kind": "fact", "text": "栗子是风筝社的社长，负责对外联系和发推。", "subject": "qq:u-lizi", "scope": "conv:qq:group:g-kite", "status": "active", "confirmed": "none", "temporal": "stable", "source": { "speaker": "qq:u-lizi", "place": "qq_group", "conversation": "qq:group:g-kite", "said_ago_days": 100 } },

    { "id": "x01", "character": "xiaoman", "type": "fact", "kind": "fact", "text": "主人最近睡得很浅，常常凌晨三点醒。", "subject": "owner", "scope": "owner", "status": "active", "confirmed": "owner_said", "temporal": "stable", "source": { "speaker": "owner", "place": "local_private", "conversation": "console:xiaoman:topic:t1", "session": "t1", "said_ago_days": 9 } },
    { "id": "x02", "character": "xiaoman", "type": "fact", "kind": "preference", "text": "主人喜欢在晚上写日记，用蓝黑墨水。", "subject": "owner", "scope": "public", "status": "active", "confirmed": "owner_said", "temporal": "stable", "source": { "speaker": "owner", "place": "local_private", "conversation": "console:xiaoman:topic:t1", "session": "t1", "said_ago_days": 30 } },
    { "id": "x03", "character": "xiaoman", "type": "fact", "kind": "fact", "text": "小满是主人家里的第二个助手，负责管理家务清单。", "subject": "owner", "scope": "owner", "status": "active", "confirmed": "owner", "temporal": "stable", "source": { "speaker": "owner", "place": "local_private", "conversation": "console:xiaoman:topic:t1", "session": "t1", "said_ago_days": 80 } },
    { "id": "x04", "character": "xiaoman", "type": "fact", "kind": "promise", "text": "主人让小满每周五晚上提醒他倒垃圾。", "subject": "owner", "scope": "owner", "status": "active", "confirmed": "owner", "temporal": "stable", "source": { "speaker": "owner", "place": "local_private", "conversation": "console:xiaoman:topic:t1", "session": "t1", "said_ago_days": 60 } },
    { "id": "x05", "character": "xiaoman", "type": "fact", "kind": "fact", "text": "主人要小满记一下，上周三要交的水电费已经交过了。", "subject": "owner", "scope": "owner", "status": "active", "confirmed": "owner_said", "temporal": "temporary", "valid_until_days": -5, "source": { "speaker": "owner", "place": "local_private", "conversation": "console:xiaoman:topic:t1", "session": "t1", "said_ago_days": 12 } }
  ]
}
