      "conv": "g1",
      "kind": "message",
      "platform_id": "",
      "from": "friend",
      "text": "第0条",
      "time_s": 0,
      "backfill": false,
      "expect": {
        "duplicate": false,
        "dropped": false,
        "character": "ca",
        "origin": "peer",
        "actor_kind": "human",
        "observed": true
