{
  "id": "platform-id-edge-cases",
  "about": "没有号（空、0）的消息不去重、不进映射表，每条单独入库；超过 2^53 的号原样往返，相邻两个号不混",
  "source_tests": [
    "TestPlatformIDEdgeCases"
  ],
  "items": [
