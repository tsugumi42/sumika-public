{
  "id": "two-accounts-same-group-one-event-two-observers",
  "about": "同一个群被两个号看到：各交一份，事件只有一条，两个角色各记一次'看到了'",
  "source_tests": [
    "TestTwoAccountsSameGroup"
  ],
  "items": [
    {
      "account": "a",
      "conv": "g1",
      "kind": "message",
      "platform_id": "500",
      "from": "friend",
      "text": "群里一句",
      "time_s": 0,
      "backfill": false,
      "expect": {
        "duplicate": false,
        "dropped": false,
        "character": "ca",
        "origin": "peer",
        "actor_kind": "human",
        "observed": true
      }
    },
    {
      "account": "b",
      "conv": "g1",
      "kind": "message",
      "platform_id": "500",
      "from": "friend",
      "text": "群里一句",
      "time_s": 0,
      "backfill": false,
      "expect": {
        "duplicate": true,
        "dropped": false,
        "character": "cb",
        "origin": "peer",
        "actor_kind": "human",
        "observed": true
      }
    }
  ],
  "final": {
    "events": [
      {
        "conv": "qq:group:900",
        "platform_id": "500",
        "actor_kind": "human",
        "actor_id": "qq:30001",
        "origin": "peer",
        "text": "群里一句",
        "time_s": 0
      }
    ],
    "observations": [
      {
        "character": "ca",
        "event": 1
      },
      {
        "character": "cb",
        "event": 1
      }
    ]
  }
}
