{
  "name": "qq-character-filter",
  "doc": "按角色过滤：character 只看那个角色观察到的；不在配置里的角色报错，不退回看全部",
  "source_tests": [
    "store/display_test.go"
  ],
  "characters": [
    {
      "id": "a",
      "name": "编造甲"
    },
    {
      "id": "b",
      "name": "编造乙"
    }
  ],
  "rows": {
    "qq": [
      {
        "table": "events",
        "values": {
          "seq": 1,
          "id": "E01",
          "channel": "qq",
          "conversation": "qq:group:90002",
          "actor_kind": "human",
          "actor_id": "70001",
          "kind": "message",
          "text": "甲看到的",
          "created_at": 1000
        }
      },
      {
        "table": "observations",
        "values": {
          "character_id": "a",
          "event_seq": 1
        }
      },
      {
        "table": "events",
        "values": {
          "seq": 2,
          "id": "E02",
          "channel": "qq",
          "conversation": "qq:group:90002",
          "actor_kind": "human",
          "actor_id": "70002",
          "kind": "message",
          "text": "乙看到的",
          "created_at": 1001
        }
      },
      {
        "table": "observations",
        "values": {
          "character_id": "b",
          "event_seq": 2
        }
      },
      {
        "table": "events",
        "values": {
          "seq": 3,
          "id": "E03",
          "channel": "qq",
          "conversation": "qq:private:80001:90001",
          "actor_kind": "human",
          "actor_id": "90001",
          "kind": "message",
          "text": "私聊里甲看到的",
          "created_at": 1002
        }
      },
      {
        "table": "observations",
        "values": {
          "character_id": "a",
          "event_seq": 3
        }
      }
    ]
  },
  "calls": [
    {
      "method": "messages.read",
      "params": {
        "request": {
          "key": {
            "platform": "qq",
            "channel": "qq",
            "scene": "group",
            "conversation": "qq:group:90002"
          },
          "limit": 200,
          "character": "b"
        }
      },
      "expect": {
        "result": {
          "state": "ready",
          "value": {
            "high_water": 3,
            "items": [
              {
                "actor_id": "70002",
                "actor_kind": "human",
                "actor_uid": "70002",
                "created_at": 1001,
                "display_name": "70002",
                "kind": "message",
                "ref": {
                  "conversation": {
                    "channel": "qq",
                    "conversation": "qq:group:90002",
                    "platform": "qq",
                    "scene": "group"
                  },
                  "event": {
                    "event_id": "E02",
                    "platform": "qq"
                  }
                },
                "seq": 2,
                "text": "乙看到的",
                "version": 1
              }
            ]
          }
        }
      }
    },
    {
      "method": "messages.read",
      "params": {
        "request": {
          "key": {
            "platform": "qq",
            "channel": "qq",
            "scene": "private",
            "conversation": "qq:private:80001:90001"
          },
          "limit": 200,
          "character": "b"
        }
      },
      "expect": {
        "result": {
          "state": "ready",
          "value": {
            "high_water": 3
          }
        }
      }
    },
    {
      "method": "messages.read",
      "params": {
        "request": {
          "key": {
            "platform": "qq",
            "channel": "qq",
            "scene": "group",
            "conversation": "qq:group:90002"
          },
          "limit": 200,
          "character": "z"
        }
      },
      "expect": {
        "error": {
          "code": 1002
        }
      }
    },
    {
      "method": "overview.read",
      "params": {
        "limit": 50,
        "character": "b"
      },
      "expect": {
        "result": {
          "state": "ready",
          "value": {
            "capabilities": [
              {
                "name": "local-group",
                "reason": "当前数据源只看历史，不能建群或发消息",
                "state": "unsupported"
              },
              {
                "name": "runtime",
                "reason": "宿主状态尚未接入",
                "state": "unsupported"
              }
            ],
            "characters": {
              "items": [
                {
                  "state": "ready",
                  "value": {
                    "id": "a",
                    "name": "编造甲"
                  }
                },
                {
                  "state": "ready",
                  "value": {
                    "id": "b",
                    "name": "编造乙"
                  }
                }
              ]
            },
            "conversations": {
              "items": [
                {
                  "key": {
                    "channel": "console",
                    "conversation": "console:b",
                    "platform": "local",
                    "scene": "private"
                  }
                },
                {
                  "has_unread": true,
                  "key": {
                    "channel": "qq",
                    "conversation": "qq:group:90002",
                    "platform": "qq",
                    "scene": "group"
                  },
                  "last": {
                    "actor_id": "70002",
                    "actor_kind": "human",
                    "actor_uid": "70002",
                    "created_at": 1001,
                    "display_name": "70002",
                    "kind": "message",
                    "ref": {
                      "conversation": {
                        "channel": "qq",
                        "conversation": "qq:group:90002",
                        "platform": "qq",
                        "scene": "group"
                      },
                      "event": {
                        "event_id": "E02",
                        "platform": "qq"
                      }
                    },
                    "seq": 2,
                    "text": "乙看到的"
                  },
                  "observers": [
                    "b"
                  ]
                }
              ]
            },
            "runtime": {
              "alerts": {},
              "reason": "宿主状态尚未接入",
              "reason_code": "runtime_not_attached"
            }
          }
        }
      }
    },
    {
      "method": "overview.read",
      "params": {
        "limit": 50,
        "character": "z"
      },
      "expect": {
        "error": {
          "code": 1002
        }
      }
    }
  ]
}
