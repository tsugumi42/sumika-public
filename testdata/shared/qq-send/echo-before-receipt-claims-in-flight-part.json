{
  "id": "echo-before-receipt-claims-in-flight-part",
  "about": "回声先于回包到达：还在发送中的段被认领成确认（via=echo，用回声的号），不等回包就发后面的段；迟到的回包不改它，回包里的号也不登记映射",
  "source_tests": [
    "TestEchoBeforeReceiptClaimsInFlightPart"
  ],
  "receipt": "hang_first",
  "steps": [
    {
      "do": "say",
      "label": "p",
      "as": "ca",
      "texts": [
        "第一条",
        "第二条"
      ],
      "expect": {}
    },
    {
      "do": "wait_sent",
      "n": 1,
      "expect": {}
    },
    {
      "do": "claim",
      "platform_id": "7001",
      "text": "第一条",
      "expect": {
        "claimed": true
      }
    },
    {
      "do": "wait_part",
      "label": "p",
      "state": "confirmed",
      "expect": {
        "plan": {
          "label": "p",
          "state": "sending",
          "parts": [
            {
              "state": "confirmed",
              "via": "echo",
              "platform_id": "7001",
              "attempts": 1
            },
            {
              "state": "pending",
              "via": "",
              "platform_id": "",
              "attempts": 0
            }
          ]
        }
      }
    },
    {
      "do": "wait_timer",
      "ms": 120,
      "expect": {}
    },
    {
      "do": "advance",
      "ms": 120,
      "expect": {}
    },
    {
      "do": "wait_plan",
      "label": "p",
      "state": "done",
      "expect": {
        "plan": {
          "label": "p",
          "state": "done",
          "parts": [
            {
              "state": "confirmed",
              "via": "echo",
              "platform_id": "7001",
              "attempts": 1
            },
            {
              "state": "confirmed",
              "via": "reply",
              "platform_id": "8002",
              "attempts": 1
            }
          ]
        }
      }
    },
    {
      "do": "release",
      "expect": {}
    }
  ],
  "final": {
    "plans": [
      {
        "label": "p",
        "state": "done",
        "parts": [
          {
            "state": "confirmed",
            "via": "echo",
            "platform_id": "7001",
            "attempts": 1
          },
          {
            "state": "confirmed",
            "via": "reply",
            "platform_id": "8002",
            "attempts": 1
          }
        ]
      }
    ],
    "sends": 2,
    "mapped": {
      "7001": "p",
      "8002": "p"
    },
    "unmapped": []
  }
}
