{
  "id": "messages-basic",
  "about": "收到的消息：私聊 / 群 / 临时会话；会话怎么定、谁发的、平台号怎么写；message 可以是段数组或空",
  "source_tests": [
    "TestTranslate",
    "TestReceive"
  ],
  "cases": [
    {
      "name": "private",
      "frame": "{\"post_type\":\"message\",\"time\":100,\"self_id\":100,\"user_id\":200,\"message_type\":\"private\",\"message_id\":300,\"sender\":{\"nickname\":\"虚构甲\"},\"message\":[{\"type\":\"text\",\"data\":{\"text\":\"你好\"}}]}",
      "expect": {
        "dropped": false,
        "inbound": {
          "kind": "message",
          "account": "100",
          "conv": "qq:private:100:200",
          "platform_id": "300",
          "from_id": "200",
          "from_nick": "虚构甲",
          "from_card": "",
          "time_unix": 100,
          "segs": [
            {
              "kind": "text",
              "text": "你好"
            }
          ]
        }
      }
    },
    {
      "name": "group-with-card",
      "frame": "{\"post_type\":\"message\",\"time\":100,\"self_id\":100,\"user_id\":200,\"group_id\":400,\"message_id\":300,\"sender\":{\"nickname\":\"虚构甲\",\"card\":\"虚构乙\"},\"message\":[]}",
      "expect": {
        "dropped": false,
        "inbound": {
          "kind": "message",
          "account": "100",
          "conv": "qq:group:400",
          "platform_id": "300",
          "from_id": "200",
          "from_nick": "虚构甲",
          "from_card": "虚构乙",
          "time_unix": 100,
          "segs": []
        }
      }
    },
    {
      "name": "temp-session-carries-group-id-stays-private",
      "frame": "{\"post_type\":\"message\",\"time\":100,\"self_id\":100,\"user_id\":200,\"group_id\":400,\"message_type\":\"private\",\"sub_type\":\"group\",\"message_id\":300,\"sender\":{\"nickname\":\"虚构甲\"},\"message\":[]}",
      "expect": {
        "dropped": false,
        "inbound": {
          "kind": "message",
          "account": "100",
          "conv": "qq:private:100:200",
          "platform_id": "300",
          "from_id": "200",
          "from_nick": "虚构甲",
          "from_card": "",
          "time_unix": 100,
          "segs": []
        }
      }
    },
    {
      "name": "sender-user-id-fallback",
      "frame": "{\"post_type\":\"message\",\"time\":100,\"self_id\":100,\"message_id\":300,\"sender\":{\"user_id\":200,\"nickname\":\"虚构甲\"},\"message\":[]}",
      "expect": {
        "dropped": false,
        "inbound": {
          "kind": "message",
          "account": "100",
          "conv": "qq:private:100:200",
          "platform_id": "300",
          "from_id": "200",
          "from_nick": "虚构甲",
          "from_card": "",
          "time_unix": 100,
          "segs": []
        }
      }
    },
    {
      "name": "outer-user-id-zero-does-not-read-sender",
      "frame": "{\"post_type\":\"message\",\"time\":100,\"self_id\":100,\"user_id\":0,\"message_id\":300,\"sender\":{\"user_id\":200},\"message\":[]}",
      "expect": {
        "dropped": false,
        "inbound": {
          "kind": "message",
          "account": "100",
          "conv": "qq:private:100:",
          "platform_id": "300",
          "from_id": "",
          "from_nick": "",
          "from_card": "",
          "time_unix": 100,
          "segs": []
        }
      }
    },
    {
      "name": "message-id-above-2-pow-53-kept-exact",
      "frame": "{\"post_type\":\"message\",\"time\":100,\"self_id\":100,\"user_id\":200,\"message_type\":\"private\",\"message_id\":9007199254740993,\"message\":[]}",
      "expect": {
        "dropped": false,
        "inbound": {
          "kind": "message",
          "account": "100",
          "conv": "qq:private:100:200",
          "platform_id": "9007199254740993",
          "from_id": "200",
          "from_nick": "",
          "from_card": "",
          "time_unix": 100,
          "segs": []
        }
      }
    },
    {
      "name": "message-id-as-string",
      "frame": "{\"post_type\":\"message\",\"time\":100,\"self_id\":100,\"user_id\":200,\"message_type\":\"private\",\"message_id\":\"300\",\"message\":[]}",
      "expect": {
        "dropped": false,
        "inbound": {
          "kind": "message",
          "account": "100",
          "conv": "qq:private:100:200",
          "platform_id": "300",
          "from_id": "200",
          "from_nick": "",
          "from_card": "",
          "time_unix": 100,
          "segs": []
        }
      }
    },
    {
      "name": "message-id-zero-kept-as-zero",
      "frame": "{\"post_type\":\"message\",\"time\":100,\"self_id\":100,\"user_id\":200,\"message_type\":\"private\",\"message_id\":0,\"message\":[]}",
      "expect": {
        "dropped": false,
        "inbound": {
          "kind": "message",
          "account": "100",
          "conv": "qq:private:100:200",
          "platform_id": "0",
          "from_id": "200",
          "from_nick": "",
          "from_card": "",
          "time_unix": 100,
          "segs": []
        }
      }
    },
    {
      "name": "message-id-missing",
      "frame": "{\"post_type\":\"message\",\"time\":100,\"self_id\":100,\"user_id\":200,\"message_type\":\"private\",\"message\":[]}",
      "expect": {
        "dropped": false,
        "inbound": {
          "kind": "message",
          "account": "100",
          "conv": "qq:private:100:200",
          "platform_id": "",
          "from_id": "200",
          "from_nick": "",
          "from_card": "",
          "time_unix": 100,
          "segs": []
        }
      }
    },
    {
      "name": "message-id-negative",
      "frame": "{\"post_type\":\"message\",\"time\":100,\"self_id\":100,\"user_id\":200,\"message_type\":\"private\",\"message_id\":-5,\"message\":[]}",
      "expect": {
        "dropped": false,
        "inbound": {
          "kind": "message",
          "account": "100",
          "conv": "qq:private:100:200",
          "platform_id": "-5",
          "from_id": "200",
          "from_nick": "",
          "from_card": "",
          "time_unix": 100,
          "segs": []
        }
      }
    },
    {
      "name": "time-missing-uses-receive-time",
      "frame": "{\"post_type\":\"message\",\"self_id\":100,\"user_id\":200,\"message_type\":\"private\",\"message_id\":300,\"message\":[]}",
      "expect": {
        "dropped": false,
        "inbound": {
          "kind": "message",
          "account": "100",
          "conv": "qq:private:100:200",
          "platform_id": "300",
          "from_id": "200",
          "from_nick": "",
          "from_card": "",
          "time_unix": 0,
          "segs": []
        }
      }
    },
    {
      "name": "message-is-string-not-array",
      "frame": "{\"post_type\":\"message\",\"time\":100,\"self_id\":100,\"user_id\":200,\"message_type\":\"private\",\"message_id\":300,\"message\":\"你好\"}",
      "expect": {
        "dropped": false,
        "inbound": {
          "kind": "message",
          "account": "100",
          "conv": "qq:private:100:200",
          "platform_id": "300",
          "from_id": "200",
          "from_nick": "",
          "from_card": "",
          "time_unix": 100,
          "segs": [
            {
              "kind": "text",
              "text": "你好"
            }
          ]
        }
      }
    },
    {
      "name": "message-missing",
      "frame": "{\"post_type\":\"message\",\"time\":100,\"self_id\":100,\"user_id\":200,\"message_type\":\"private\",\"message_id\":300}",
      "expect": {
        "dropped": false,
        "inbound": {
          "kind": "message",
          "account": "100",
          "conv": "qq:private:100:200",
          "platform_id": "300",
          "from_id": "200",
          "from_nick": "",
          "from_card": "",
          "time_unix": 100,
          "segs": []
        }
      }
    }
  ]
}
