      "expect": {
        "dropped": false,
        "notice": {
          "kind": "poke",
          "account": "100",
          "conv": "qq:group:400",
          "time_unix": 100,
          "actor": "200",
          "target": "100",
          "msg_id": "",
          "ref": "",
          "raw": ""
