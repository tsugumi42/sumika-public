    "TestTranslate segmentCases"
  ],
  "cases": [
    {
      "name": "text",
      "frame": "{\"post_type\":\"message\",\"time\":100,\"self_id\":100,\"user_id\":200,\"message_id\":300,\"sender\":{\"nickname\":\"虚构甲\",\"card\":\"虚构乙\"},\"message\":[{\"type\":\"text\",\"data\":{\"text\":\"你好\"}}]}",
      "expect": {
        "dropped": false,
        "inbound": {
          "kind": "message",
          "account": "100",
          "conv": "qq:private:100:200",
          "platform_id": "300",
          "from_id": "200",
          "from_nick": "虚构甲",
          "from_card": "虚构乙",
          "time_unix": 100,
          "segs": [
            {
              "kind": "text",
              "text": "你好"
            }
          ]
        }
      }
    },
