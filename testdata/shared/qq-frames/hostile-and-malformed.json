{
  "id": "hostile-and-malformed",
  "about": "坏帧和敌对输入：不是 JSON、不是对象、缺 post_type、认不出的 post_type，都不能崩，也不能交出半截数据",
  "source_tests": [
    "TestReceive",
    "snowluma/zero_id_test.go"
  ],
  "cases": [
    {
      "name": "not-json",
      "frame": "invalid",
      "expect": {
        "dropped": true
      }
    },
    {
      "name": "empty",
      "frame": "",
      "expect": {
        "dropped": true
      }
    },
    {
      "name": "json-null",
      "frame": "null",
      "expect": {
        "dropped": true
      }
    },
    {
      "name": "json-array",
      "frame": "[]",
      "expect": {
        "dropped": true
      }
    },
    {
      "name": "json-number",
      "frame": "1",
      "expect": {
        "dropped": true
      }
    },
    {
      "name": "empty-object",
      "frame": "{}",
      "expect": {
        "dropped": true
      }
    },
    {
      "name": "unknown-post-type",
      "frame": "{\"post_type\":\"mystery\",\"time\":100,\"self_id\":100}",
      "expect": {
        "dropped": true
      }
    },
    {
      "name": "message-segment-not-object",
      "frame": "{\"post_type\":\"message\",\"time\":100,\"self_id\":100,\"user_id\":200,\"message_id\":300,\"sender\":{\"nickname\":\"虚构甲\",\"card\":\"虚构乙\"},\"message\":[\"文字\"]}",
      "expect": {
        "dropped": false,
        "inbound": {
          "kind": "message",
          "account": "100",
          "conv": "qq:private:100:200",
          "platform_id": "300",
          "from_id": "200",
          "from_nick": "虚构甲",
          "from_card": "虚构乙",
          "time_unix": 100,
          "segs": [
            {
              "kind": "other",
              "raw": "\"文字\""
            }
          ]
        }
      }
    },
    {
      "name": "message-user-id-zero-no-sender",
      "frame": "{\"post_type\":\"message\",\"time\":100,\"self_id\":100,\"user_id\":0,\"message_type\":\"private\",\"message_id\":300,\"message\":[]}",
      "expect": {
        "dropped": false,
        "inbound": {
          "kind": "message",
          "account": "100",
          "conv": "qq:private:100:",
          "platform_id": "300",
          "from_id": "",
          "from_nick": "",
          "from_card": "",
          "time_unix": 100,
          "segs": []
        }
      }
    },
    {
      "name": "self-id-missing",
      "frame": "{\"post_type\":\"message\",\"time\":100,\"user_id\":200,\"message_type\":\"private\",\"message_id\":300,\"message\":[]}",
      "expect": {
        "dropped": false,
        "inbound": {
          "kind": "message",
          "account": "",
          "conv": "qq:private::200",
          "platform_id": "300",
          "from_id": "200",
          "from_nick": "",
          "from_card": "",
          "time_unix": 100,
          "segs": []
        }
      }
    }
  ]
}
